# VesselStack public configuration. Copy to vesselstack.env and edit.
BOAT_NAME="My Boat"
BOAT_TYPE="Motor vessel"
BOAT_MMSI=""
BOAT_CALLSIGN=""
BOAT_LOA_M=""
BOAT_BEAM_M=""
BOAT_TIMEZONE="America/Los_Angeles"
BOAT_UNITS="us_customary"

# Installation identity and paths.
VESSELSTACK_USER="boat"
VESSELSTACK_UID="1000"
VESSELSTACK_GID="1000"
VESSELSTACK_ROOT="/opt/vesselstack"
VESSELSTACK_DATA="/opt/vesselstack-data"
VESSELSTACK_BACKUP="/media/vesselstack-backup/backups"

# SignalK mode: existing, docker, or native. Hardware modules are opt-in.
SIGNALK_MODE="existing"
SIGNALK_VERSION="v2.27.0"
SIGNALK_URL="http://127.0.0.1:3000"
SOCKETCAN_ENABLE="false"
SOCKETCAN_INTERFACE="can0"
SOCKETCAN_BITRATE="250000"
# true creates a missing vcan* interface at boot (home-lab replay only).
VESSELSTACK_CAN_CREATE_VCAN="false"
AIS_ENABLE="false"
AIS_IMAGE="ghcr.io/jvde-github/ais-catcher:v0.70"
AIS_DEVICE="/dev/bus/usb"
AIS_CATCHER_ARGS="-q -N 8100 -S 5011"
AIS_WEB_PORT="8100"
AIS_TCP_PORT="5011"
HOME_ASSISTANT_URL="http://127.0.0.1:8123"
HOME_ASSISTANT_TOKEN=""
INFLUXDB_URL="http://127.0.0.1:8086"
INFLUXDB_PORT="8086"
INFLUXDB_CONTAINER_NAME="vesselstack-influxdb"
INFLUXDB_ORG="vesselstack"
INFLUXDB_USERNAME="boatadmin"
INFLUXDB_RAW_BUCKET="signalk"
INFLUXDB_HISTORY_BUCKET="signalk_1m"
INFLUXDB_HOME_ASSISTANT_BUCKET="homeassistant"
INFLUXDB_AIS_BUCKET="ais"
# Raw (full-resolution) bucket retention: a duration such as 720h, 30d or 8w, or
# 0 to keep forever. Leave EMPTY to use 30d on a NEW install and to leave an
# EXISTING install's bucket untouched. Setting a value applies it to the existing
# bucket and permanently deletes raw data older than that window.
INFLUXDB_RAW_RETENTION=""
# How long Prometheus keeps metrics (stored in $VESSELSTACK_DATA/prometheus): a
# duration such as 720h, 30d or 8w. Default 30d.
PROMETHEUS_RETENTION="30d"
INFLUXDB_PASSWORD="GENERATE"
INFLUXDB_TOKEN="GENERATE"
GRAFANA_ADMIN_PASSWORD="GENERATE"
MQTT_USERNAME="homeassistant"
MQTT_PASSWORD="GENERATE"
MQTT_PORT="1883"

# Mosquitto always enforces an ACL: the MQTT account above keeps full access and
# unlisted accounts get none. Enabling displays adds a scoped bridge account and
# one read-only account per display; their passwords are generated into
# config/displays.secrets.json. See README "MQTT access control".
DISPLAYS_ENABLE="false"
DISPLAYS_BRIDGE_MQTT_USERNAME="vesselstack-bridge"
# Optional. With DISPLAYS_ENABLE=true the bridge service reads SignalK
# (vessels.self). Set a SignalK access token only if SignalK security requires
# one; it is sent as "Authorization: Bearer" and never logged. Leave empty otherwise.
DISPLAYS_SIGNALK_TOKEN=""
# Optional. Only for Home Assistant items ("ha" in displays.json). A long-lived access
# token of a dedicated NON-admin Home Assistant user (Profile -> Security); it is sent
# in the websocket handshake, stored 0600 root and never logged. The token carries
# that user's rights (it is not read-only), which is why the user should not be an admin.
# HOME_ASSISTANT_URL above is where the bridge connects. Leave empty without ha items.
DISPLAYS_HA_TOKEN=""

# Boat Chat works without an LLM and can be configured later in its UI.
BOAT_CHAT_PROVIDER="local"
BOAT_CHAT_HOST="0.0.0.0"
BOAT_CHAT_PORT="8765"
BOAT_CHAT_SETTINGS_TOKEN="GENERATE"
# Required by Boat Chat chat/status/data APIs and the Telegram bridge. GENERATE
# creates a random value (kept on re-install). Leaving it empty fails closed.
BOAT_CHAT_ACCESS_TOKEN="GENERATE"
TELEGRAM_ENABLE="false"
TELEMETRY_INDEXER_ENABLE="true"

# Bind addresses for published container ports. Data services (InfluxDB,
# Prometheus, MQTT) are loopback-only by default; Home Assistant and SignalK are
# host-networked and reach them on 127.0.0.1. Set the data address to a trusted
# LAN/VPN IPv4 address only if external devices must publish to MQTT/InfluxDB.
# Grafana and Heimdall stay LAN-reachable by default for dashboards; use
# 127.0.0.1 to restrict them to this device (or a reverse proxy/VPN).
VESSELSTACK_DATA_BIND_ADDRESS="127.0.0.1"
VESSELSTACK_WEB_BIND_ADDRESS="0.0.0.0"
# Home Assistant (host-networked). 127.0.0.1 makes the installer/`vesselstackctl lan` manage a
# delimited http block in ${VESSELSTACK_DATA}/homeassistant/configuration.yaml (never your own
# http: section). SignalK has no bind setting and always listens on every interface.
HOMEASSISTANT_BIND_ADDRESS="0.0.0.0"

# Published host ports used by status, doctor, and urls.
GRAFANA_PORT="43000"
HEIMDALL_PORT="80"
HEIMDALL_HTTPS_PORT="443"
PROMETHEUS_PORT="9090"

# Network policy. Administrative ports are blocked on this interface.
VESSELSTACK_UNTRUSTED_INTERFACE="wlan0"
VESSELSTACK_FIREWALL_ENABLE="false"
# Opt-in strict mode: drop ALL traffic arriving on the untrusted interface except
# replies, ICMP, DHCP and the allow-lists below (comma-separated ports or LOW:HIGH
# ranges). Keep an alternate administration path (Ethernet/console) available.
VESSELSTACK_FIREWALL_STRICT="false"
VESSELSTACK_FIREWALL_ALLOW_TCP="22"
VESSELSTACK_FIREWALL_ALLOW_UDP=""

# Local-first administration UI. Keep loopback binding unless access is
# protected by a trusted VPN or authenticated reverse proxy.
CONTROL_PANEL_HOST="127.0.0.1"
CONTROL_PANEL_PORT="8780"
