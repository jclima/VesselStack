[Unit]
Description=VesselStack diagnostic assistant
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@VESSELSTACK_USER@
Group=@VESSELSTACK_USER@
WorkingDirectory=@VESSELSTACK_ROOT@
EnvironmentFile=@VESSELSTACK_ROOT@/config/boat-chat.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=BOAT_CHAT_SERVICE_NAME=vesselstack-chat.service
ExecStart=@VESSELSTACK_ROOT@/boat-chat/.venv/bin/python @VESSELSTACK_ROOT@/boat-chat/app.py
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
CapabilityBoundingSet=
LockPersonality=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
