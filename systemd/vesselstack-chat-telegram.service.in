[Unit]
Description=VesselStack Telegram boat assistant
After=network-online.target vesselstack-chat.service
Wants=network-online.target
Requires=vesselstack-chat.service

[Service]
Type=simple
User=@VESSELSTACK_USER@
Group=@VESSELSTACK_USER@
WorkingDirectory=@VESSELSTACK_ROOT@/boat-chat
EnvironmentFile=@VESSELSTACK_ROOT@/config/boat-chat.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=@VESSELSTACK_ROOT@/boat-chat/.venv/bin/python @VESSELSTACK_ROOT@/boat-chat/telegram_bot.py
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
CapabilityBoundingSet=
LockPersonality=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
