[Unit]
Description=VesselStack telemetry memory indexer
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=@VESSELSTACK_USER@
Group=@VESSELSTACK_USER@
WorkingDirectory=@VESSELSTACK_ROOT@/boat-chat
EnvironmentFile=@VESSELSTACK_ROOT@/config/boat-chat.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=@VESSELSTACK_ROOT@/boat-chat/.venv/bin/python @VESSELSTACK_ROOT@/boat-chat/telemetry_indexer.py run
NoNewPrivileges=true
PrivateTmp=true
CapabilityBoundingSet=
LockPersonality=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
SystemCallArchitectures=native
