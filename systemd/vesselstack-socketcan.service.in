[Unit]
Description=VesselStack SocketCAN interface
After=systemd-modules-load.service
Before=vesselstack-signalk.service docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
# Rendered by scripts/configure-hardware.sh. Physical can* interfaces get the
# bitrate and restart-ms below; virtual vcan* interfaces (home-lab replay) accept
# neither, so they are only created (opt-in) and brought up.
ExecStartPre=@CAN_PRE_MODPROBE@
ExecStartPre=@CAN_PRE_CREATE@
ExecStart=/usr/sbin/ip link set @CAN_INTERFACE@ up@CAN_LINK_ARGS@
ExecStop=/usr/sbin/ip link set @CAN_INTERFACE@ down

[Install]
WantedBy=multi-user.target
