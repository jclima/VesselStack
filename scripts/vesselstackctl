#!/bin/bash
# Lifecycle management for an installed VesselStack system.

set -euo pipefail
umask 077

ROOT=${VESSELSTACK_ROOT:-/opt/vesselstack}
ENV_FILE=${VESSELSTACK_ENV:-$ROOT/config/vesselstack.env}
SYSTEM_ROOT=${VESSELSTACK_SYSTEM_ROOT:-}
SYSTEMD_DIR="$SYSTEM_ROOT/etc/systemd/system"
SBIN_DIR="$SYSTEM_ROOT/usr/local/sbin"

usage() {
    cat <<'EOF'
Usage: vesselstackctl COMMAND [ARGUMENTS]

Commands:
  status                       Show a concise service and endpoint summary
  doctor                       Validate config, dependencies, disk, and health
  urls                         Show who can reach each service (real listening state) and the
                               addresses to use from other devices
  version                      Print installed and command versions
  reindex                      Rebuild Boat Chat's memory index as the service user
                               (fixes "memory ... not ready" and a failing doctor check)
  logs [chat|telegram|indexer|control|containers|all]
                               Show recent diagnostic logs (default: all)
  start                        Start the stack
  stop                         Stop the stack
  restart                      Restart the stack
  backup [--allow-unmounted] [DIRECTORY]
                               Create a checksummed, consistent backup (stops the
                               whole stack briefly). Refuses /media and /mnt
                               destinations that are not mounted unless
                               --allow-unmounted is given
  verify-backup ARCHIVE        Verify an archive and its checksum
  restore ARCHIVE --yes [--skip-installer]
                               Stage and verify a backup, then swap it in; the
                               previous trees are kept as *.pre-restore-STAMP
  update [--offline] SOURCE_DIRECTORY
                               Back up and apply a reviewed release; --offline (or
                               VESSELSTACK_OFFLINE=true) installs without network
  uninstall [--purge-data --yes]
                               Remove services; preserve data by default
EOF
}

require_root() {
    [ "$(id -u)" -eq 0 ] || { echo "This command requires root" >&2; exit 1; }
}

load_config() {
    [ -r "$ENV_FILE" ] || { echo "Missing installed config: $ENV_FILE" >&2; exit 1; }
    # shellcheck disable=SC1090
    source "$ENV_FILE"
    : "${VESSELSTACK_ROOT:?Missing VESSELSTACK_ROOT}"
    : "${VESSELSTACK_DATA:?Missing VESSELSTACK_DATA}"
    COMPOSE=(docker compose)
    [ "${SIGNALK_MODE:-existing}" = docker ] && COMPOSE+=(--profile signalk)
    [ "${AIS_ENABLE:-false}" = true ] && COMPOSE+=(--profile ais)
    COMPOSE+=(--env-file "$ENV_FILE" -f "$VESSELSTACK_ROOT/compose.yml")
}

# Run the bundled memory-index helper (as the service user). Returns non-zero when it
# is missing or fails; callers decide how loud to be.
memory_index_helper() {
    local helper="$VESSELSTACK_ROOT/installer/scripts/memory-index.sh"
    [ -x "$helper" ] || { echo "Missing bundled memory index helper: $helper (rerun the installer)" >&2; return 1; }
    "$helper" "$ENV_FILE" "$@"
}

ensure_memory_index() {
    if ! memory_index_helper ensure; then
        echo "WARN: the Boat Chat memory index could not be built; Boat Chat will report 'not ready'. Fix: sudo vesselstackctl reindex" >&2
        return 1
    fi
}

start_stack() {
    local installer_scripts="$VESSELSTACK_ROOT/installer/scripts"
    if [ "${SOCKETCAN_ENABLE:-false}" = true ]; then
        [ -x "$installer_scripts/configure-hardware.sh" ] || {
            echo "Missing bundled hardware configurator: $installer_scripts/configure-hardware.sh" >&2
            return 1
        }
        "$installer_scripts/configure-hardware.sh" "$ENV_FILE"
    fi
    if [ "${VESSELSTACK_FIREWALL_ENABLE:-false}" = true ]; then
        systemctl enable --now vesselstack-firewall.service
    fi
    [ -x "$installer_scripts/mosquitto-credentials.sh" ] || {
        echo "Missing bundled Mosquitto helper: $installer_scripts/mosquitto-credentials.sh" >&2
        return 1
    }
    "$installer_scripts/mosquitto-credentials.sh" "$ENV_FILE"
    "${COMPOSE[@]}" up -d
    [ -x "$installer_scripts/bootstrap-influx.sh" ] || {
        echo "Missing bundled InfluxDB provisioner: $installer_scripts/bootstrap-influx.sh" >&2
        return 1
    }
    # bootstrap-influx.sh first waits (bounded) for InfluxDB /health, so start,
    # restart and the backup restart trap never provision against a booting server.
    "$installer_scripts/bootstrap-influx.sh" "$ENV_FILE"
    if [ "${SIGNALK_MODE:-existing}" = native ]; then
        systemctl start vesselstack-signalk.service
    fi
    # Existing installs have no index until the first start after upgrading: build it
    # (cheap when nothing changed) before Boat Chat starts. Never blocks the start.
    ensure_memory_index || true
    systemctl start vesselstack-chat.service
    if [ "${TELEGRAM_ENABLE:-false}" = true ]; then
        systemctl start vesselstack-chat-telegram.service
    fi
    if [ "${TELEMETRY_INDEXER_ENABLE:-true}" = true ]; then
        systemctl start vesselstack-telemetry-indexer.timer
    fi
    systemctl start vesselstack-control-panel.service
}

stop_stack() {
    systemctl stop vesselstack-chat-telegram.service 2>/dev/null || true
    systemctl stop vesselstack-telemetry-indexer.timer 2>/dev/null || true
    systemctl stop vesselstack-chat.service || true
    if [ "${SIGNALK_MODE:-existing}" = native ]; then
        systemctl stop vesselstack-signalk.service || true
    fi
    "${COMPOSE[@]}" down
    if [ "${SOCKETCAN_ENABLE:-false}" = true ]; then
        systemctl stop vesselstack-socketcan.service || true
    fi
}

status_unit() {
    local label=$1 unit=$2 enabled=${3:-true}
    if [ "$enabled" != true ]; then
        printf '%-20s %s\n' "$label" disabled
    elif systemctl is-active --quiet "$unit"; then
        printf '%-20s %s\n' "$label" healthy
    else
        printf '%-20s %s\n' "$label" unhealthy
        return 1
    fi
}

check_endpoint() {
    local label=$1 endpoint=$2
    if curl --connect-timeout 3 --max-time 10 --fail --silent --show-error "$endpoint" >/dev/null; then
        printf '%-20s %s\n' "$label" healthy
    else
        printf '%-20s %s\n' "$label" "unreachable ($endpoint)" >&2
        return 1
    fi
}

check_chat_endpoint() {
    local endpoint=$1
    if curl --connect-timeout 3 --max-time 10 --fail --silent --show-error "$endpoint" | python3 -c '
import json, sys
try:
    data = json.load(sys.stdin)
except (ValueError, TypeError):
    raise SystemExit(1)
raise SystemExit(0 if data.get("ok") is True and data.get("ready") is True else 1)
'; then
        printf '%-20s %s\n' 'Boat Chat' ready
    else
        printf '%-20s %s\n' 'Boat Chat' 'unavailable or not ready' >&2
        return 1
    fi
}

status_stack() {
    local failed=0 service running_services
    local services=(homeassistant influxdb grafana prometheus mosquitto heimdall)
    [ "${SIGNALK_MODE:-existing}" = docker ] && services+=(signalk)
    [ "${AIS_ENABLE:-false}" = true ] && services+=(ais-catcher)
    printf '%-20s %s\n' COMPONENT STATE
    printf '%-20s %s\n' -------------------- --------------------
    status_unit 'Boat Chat service' vesselstack-chat.service || failed=1
    status_unit 'Telegram worker' vesselstack-chat-telegram.service \
        "${TELEGRAM_ENABLE:-false}" || failed=1
    status_unit 'Telemetry indexer' vesselstack-telemetry-indexer.timer \
        "${TELEMETRY_INDEXER_ENABLE:-true}" || failed=1
    status_unit 'Native SignalK' vesselstack-signalk.service \
        "$([ "${SIGNALK_MODE:-existing}" = native ] && echo true || echo false)" || failed=1
    status_unit 'SocketCAN' vesselstack-socketcan.service \
        "${SOCKETCAN_ENABLE:-false}" || failed=1
    status_unit 'Control Panel' vesselstack-control-panel.service || failed=1
    if ! running_services=$("${COMPOSE[@]}" ps --status running --services); then
        printf '%-20s %s\n' 'Compose state' unavailable
        failed=1
        running_services=''
    fi
    for service in "${services[@]}"; do
        if grep -Fxq "$service" <<<"$running_services"; then
            printf '%-20s %s\n' "$service" healthy
        else
            printf '%-20s %s\n' "$service" 'not running'
            failed=1
        fi
    done
    check_chat_endpoint "http://127.0.0.1:${BOAT_CHAT_PORT:-8765}/health" || failed=1
    check_endpoint 'Control Panel' "http://127.0.0.1:${CONTROL_PANEL_PORT:-8780}/health" || failed=1
    check_endpoint SignalK "${SIGNALK_URL%/}/signalk" || failed=1
    check_endpoint 'Home Assistant' "${HOME_ASSISTANT_URL%/}/manifest.json" || failed=1
    check_endpoint InfluxDB "${INFLUXDB_URL%/}/health" || failed=1
    check_endpoint Grafana "http://127.0.0.1:${GRAFANA_PORT:-43000}/api/health" || failed=1
    printf '\nRun vesselstackctl doctor for configuration and dependency checks.\n'
    return "$failed"
}

# Read KEY from an env file WITHOUT sourcing it (some are service-user-writable).
env_file_value() {
    local file=$1 key=$2 value
    [ -r "$file" ] || return 0
    value=$(grep -E "^${key}=" "$file" 2>/dev/null | tail -n 1 | cut -d= -f2- || true)
    value=${value#\'}; value=${value%\'}; value=${value#\"}; value=${value%\"}
    printf '%s' "$value"
}

# Classify a configured bind address: all | loopback | other.
bind_kind() {
    case "$1" in
        127.*|::1|localhost) printf loopback ;;
        0.0.0.0|::|''|'*') printf all ;;
        *) printf other ;;
    esac
}

# Listening TCP sockets as "address port" lines, from `ss -ltn`. Empty (and
# LISTENERS_KNOWN=0) when ss is missing or fails, so callers fall back to configuration.
LISTENERS=''
LISTENERS_KNOWN=0
collect_listeners() {
    local raw
    command -v ss >/dev/null 2>&1 || return 0
    raw=$(ss -ltn 2>/dev/null) || return 0
    LISTENERS=$(awk '$1 == "LISTEN" {
        n = split($4, parts, ":"); port = parts[n]
        addr = substr($4, 1, length($4) - length(port) - 1)
        gsub(/[\[\]]/, "", addr); sub(/%.*/, "", addr)
        if (addr == "*" || addr == "" || addr == "::") addr = "0.0.0.0"
        if (addr == "::1") addr = "127.0.0.1"
        print addr, port }' <<<"$raw")
    [ -z "$LISTENERS" ] || LISTENERS_KNOWN=1
}

# Real bind state of a TCP port: sets BOUND_KIND (all|loopback|other|none) and
# BOUND_ADDR (the specific address for "other").
listening_state() {
    local port=$1 addr p
    BOUND_KIND=none
    BOUND_ADDR=''
    while read -r addr p; do
        [ "$p" = "$port" ] || continue
        case "$(bind_kind "$addr")" in
            all) BOUND_KIND=all ;;
            loopback) [ "$BOUND_KIND" = all ] || [ "$BOUND_KIND" = other ] || BOUND_KIND=loopback ;;
            other) [ "$BOUND_KIND" = all ] || { BOUND_KIND=other; BOUND_ADDR=$addr; } ;;
        esac
    done <<<"$LISTENERS"
}

# Names and IPv4 addresses other devices can use to reach this machine: the mDNS name
# plus every non-loopback address except container/virtual bridge interfaces.
REACH_HOSTS=()
REACH_NOTES=()
collect_reachable() {
    local name short iface cidr address
    name=$(hostname 2>/dev/null || true)
    short=${name%%.*}
    if [ -n "$short" ]; then
        REACH_HOSTS+=("$short.local")
        REACH_NOTES+=("mDNS name; works where Avahi or Bonjour is available")
    fi
    if command -v ip >/dev/null 2>&1; then
        while read -r iface cidr; do
            case "$iface" in
                lo|docker*|br-*|veth*|virbr*|cni*|flannel*|cali*|vxlan*|lxc*|lxd*) continue ;;
            esac
            address=${cidr%%/*}
            case "$address" in 127.*|169.254.*|'') continue ;; esac
            REACH_HOSTS+=("$address")
            REACH_NOTES+=("interface $iface")
        done < <(ip -o -4 addr show scope global 2>/dev/null | awk '{print $2, $4}')
    fi
}

# One service: LABEL PORT SCHEME CONFIGURED_ADDRESS [HOST_NETWORK] [EXTRA_NOTE] [CHANGE_HINT]
#   host-network services are not published by Docker, so without a real socket listing
#   the configured address is unknown and they are assumed to listen on every interface.
url_for() {
    local scheme=$1 host=$2 port=$3
    if [ "$scheme" = http ] && [ "$port" = 80 ]; then printf 'http://%s' "$host"
    else printf '%s://%s:%s' "$scheme" "$host" "$port"; fi
}

show_service() {
    local label=$1 port=$2 scheme=$3 configured=$4 host_network=${5:-no} extra=${6:-} hint=${7:-}
    local kind addr='' source=listening state i
    listening_state "$port"
    kind=$BOUND_KIND
    addr=$BOUND_ADDR
    if [ "$LISTENERS_KNOWN" -eq 0 ] || [ "$kind" = none ]; then
        if [ "$host_network" = yes ] && [ "$LISTENERS_KNOWN" -eq 0 ]; then
            kind=all; source='assumed: host networking, not verified'
        elif [ "$host_network" = yes ]; then
            kind=none; source='not listening'
        else
            kind=$(bind_kind "$configured"); addr=$configured
            if [ "$LISTENERS_KNOWN" -eq 0 ]; then source='from configuration'; else source='from configuration, not seen listening'; fi
        fi
    fi
    case "$kind" in
        all) state='ALL interfaces - reachable from other devices' ;;
        loopback) state='this device only' ;;
        other) state="interface $addr only" ;;
        *) state='not listening' ;;
    esac
    [ "$source" = listening ] || state="$state ($source)"
    printf '%-20s %s%s\n' "$label" "$state" "${extra:+; $extra}"
    case "$kind" in
        none) return 0 ;;
        other) printf '%-20s %s\n' '' "  $(url_for "$scheme" "$addr" "$port")" ;;
        *) printf '%-20s %s\n' '' "  $(url_for "$scheme" 127.0.0.1 "$port")   (on this device)" ;;
    esac
    if [ "$kind" = all ]; then
        for i in "${!REACH_HOSTS[@]}"; do
            printf '%-20s %s\n' '' "  $(url_for "$scheme" "${REACH_HOSTS[$i]}" "$port")   (from other devices: ${REACH_NOTES[$i]})"
        done
    fi
    if [ "$kind" = loopback ] && [ -n "$hint" ]; then
        printf '%-20s %s\n' '' "  $hint"
    fi
    return 0
}

# Host and port of a URL (no credentials expected): prints "HOST PORT".
url_host_port() {
    local rest=${1#*://} default=$2 hostport host port
    hostport=${rest%%/*}
    hostport=${hostport##*@}
    host=${hostport%%:*}
    port=${hostport##*:}
    [ "$port" != "$hostport" ] || port=$default
    printf '%s %s\n' "$host" "$port"
}

show_urls() {
    local chat_host panel_host data_bind=${VESSELSTACK_DATA_BIND_ADDRESS:-127.0.0.1}
    local web_bind=${VESSELSTACK_WEB_BIND_ADDRESS:-0.0.0.0} host port i
    chat_host=$(env_file_value "$ROOT/config/boat-chat.env" BOAT_CHAT_HOST)
    chat_host=${chat_host:-${BOAT_CHAT_HOST:-0.0.0.0}}
    panel_host=$(env_file_value "$ROOT/config/control-panel.env" CONTROL_PANEL_HOST)
    panel_host=${panel_host:-${CONTROL_PANEL_HOST:-127.0.0.1}}
    collect_listeners
    collect_reachable
    printf 'Addresses other devices on this network can use to reach this machine:\n'
    if [ "${#REACH_HOSTS[@]}" -eq 0 ]; then
        printf '  (none found: no network address besides loopback)\n'
    fi
    for i in "${!REACH_HOSTS[@]}"; do
        printf '  %-28s %s\n' "${REACH_HOSTS[$i]}" "${REACH_NOTES[$i]}"
    done
    if [ "$LISTENERS_KNOWN" -eq 0 ]; then
        printf 'Note: listening sockets could not be inspected (ss unavailable); bind state is taken from the configuration.\n'
    fi
    printf '\n'
    show_service 'Boat Chat' "${BOAT_CHAT_PORT:-8765}" http "$chat_host" no 'access token required' \
        'to change: sudo vesselstackctl lan dashboards'
    show_service 'Control Panel' "${CONTROL_PANEL_PORT:-8780}" http "$panel_host" no \
        'root-level editor, loopback by design' \
        "to reach it: ssh -L ${CONTROL_PANEL_PORT:-8780}:127.0.0.1:${CONTROL_PANEL_PORT:-8780} USER@HOST (SSH tunnel)"
    if [ "${SIGNALK_MODE:-existing}" = existing ]; then
        printf '%-20s %s\n' SignalK "existing server, not managed here: $SIGNALK_URL"
    else
        read -r host port < <(url_host_port "$SIGNALK_URL" 3000)
        show_service SignalK "$port" http "$host" yes 'host-networked container; vesselstackctl lan does not change it'
    fi
    read -r host port < <(url_host_port "$HOME_ASSISTANT_URL" 8123)
    case "$(bind_kind "$host")" in
        loopback) show_service 'Home Assistant' "$port" http "$host" yes 'host-networked container; vesselstackctl lan does not change it' ;;
        *) printf '%-20s %s\n' 'Home Assistant' "external server, not managed here: $HOME_ASSISTANT_URL" ;;
    esac
    show_service Grafana "${GRAFANA_PORT:-43000}" http "$web_bind" no '' 'to change: sudo vesselstackctl lan dashboards'
    show_service Heimdall "${HEIMDALL_PORT:-80}" http "$web_bind" no '' 'to change: sudo vesselstackctl lan dashboards'
    show_service InfluxDB "${INFLUXDB_PORT:-8086}" http "$data_bind" no 'API token required' 'to change: sudo vesselstackctl lan all'
    show_service Prometheus "${PROMETHEUS_PORT:-9090}" http "$data_bind" no 'NO login' 'to change: sudo vesselstackctl lan all'
    show_service MQTT "${MQTT_PORT:-1883}" mqtt "$data_bind" no 'password required' 'to change: sudo vesselstackctl lan all'
    printf '\nChange who can reach the dashboards with: sudo vesselstackctl lan [local|dashboards|all]\n'
}

show_version() {
    local installed=unknown
    [ -r "$ROOT/config/installed-version" ] && installed=$(<"$ROOT/config/installed-version")
    printf 'VesselStack installed: %s\n' "$installed"
    printf 'vesselstackctl source: %s\n' "${VESSELSTACK_VERSION:-$installed}"
}

show_logs() {
    local target=${1:-all}
    case "$target" in
        chat) journalctl -u vesselstack-chat.service -n 100 --no-pager ;;
        telegram) journalctl -u vesselstack-chat-telegram.service -n 100 --no-pager ;;
        indexer) journalctl -u vesselstack-telemetry-indexer.service -n 100 --no-pager ;;
        control) journalctl -u vesselstack-control-panel.service -n 100 --no-pager ;;
        containers) "${COMPOSE[@]}" logs --tail 100 ;;
        all)
            journalctl -u vesselstack-chat.service -n 100 --no-pager
            journalctl -u vesselstack-chat-telegram.service -n 100 --no-pager
            journalctl -u vesselstack-telemetry-indexer.service -n 100 --no-pager
            journalctl -u vesselstack-control-panel.service -n 100 --no-pager
            "${COMPOSE[@]}" logs --tail 100
            ;;
        *) echo 'logs target must be chat, telegram, indexer, control, containers, or all' >&2; exit 2 ;;
    esac
}

# Warn (never fail) when the data filesystem is more than 80% full. Time-series
# data grows without bound unless INFLUXDB_RAW_RETENTION is set.
disk_usage_warning() {
    local threshold=${VESSELSTACK_DISK_WARN_PERCENT:-80} used data_size
    used=$(df -Pk "$VESSELSTACK_DATA" | awk 'NR==2 {gsub("%", "", $5); print $5}')
    data_size=$(du -sk "$VESSELSTACK_DATA" 2>/dev/null | awk '{printf "%d", $1 / 1024}')
    if [ -n "$used" ] && [ "$used" -gt "$threshold" ]; then
        printf 'WARN data filesystem is %s%% full (threshold %s%%); %s MiB used by %s. Consider INFLUXDB_RAW_RETENTION, pruning old backups or a larger disk\n' \
            "$used" "$threshold" "${data_size:-?}" "$VESSELSTACK_DATA" >&2
    else
        printf 'OK   data filesystem usage: %s%% (%s MiB in data directory)\n' "${used:-?}" "${data_size:-?}"
    fi
}

# The signalk-server image runs as uid/gid 1000. A bind-mount source that Docker
# created as root:root (or that is otherwise not writable by uid 1000) makes SignalK
# exit with "EACCES: permission denied, open '/home/node/.signalk/package.json'".
check_signalk_data_dir() {
    local dir="$VESSELSTACK_DATA/signalk" uid gid mode running writable=0
    [ "${SIGNALK_MODE:-existing}" = docker ] || return 0
    [ -d "$dir" ] || { printf 'WARN SignalK data directory %s does not exist; rerun the installer\n' "$dir" >&2; return 0; }
    read -r uid gid mode < <(stat -c '%u %g %a' "$dir")
    if [ "$uid" = 1000 ] && [ $((8#$mode & 8#200)) -ne 0 ]; then writable=1; fi
    if [ "$gid" = 1000 ] && [ $((8#$mode & 8#020)) -ne 0 ]; then writable=1; fi
    if [ $((8#$mode & 8#002)) -ne 0 ]; then writable=1; fi
    [ "$writable" -eq 0 ] || { printf 'OK   SignalK data directory is writable by the container user (uid 1000)\n'; return 0; }
    # A crash-looping container flaps between restarting and running, so the
    # container state does not change the verdict: SignalK cannot work here.
    running=$("${COMPOSE[@]}" ps --status running --services 2>/dev/null || true)
    if grep -Fxq signalk <<<"$running"; then state='is running or restarting'; else state='is not running'; fi
    printf 'FAIL SignalK container %s and its data directory %s is owned by %s:%s (mode %s), not writable by the container user (uid 1000).\n' \
        "$state" "$dir" "$uid" "$gid" "$mode" >&2
    printf '     Typical log: EACCES: permission denied, open '"'"'/home/node/.signalk/package.json'"'"'\n' >&2
    printf '     Fix: sudo chown -R 1000:1000 %s && docker restart vesselstack-signalk\n' "$dir" >&2
    return 1
}

# Boat Chat reports itself "not ready" while its memory index has no chunks. Ask the
# running service first (its /health readiness); if it does not answer, ask the helper,
# which opens the database as the service user (root must never create SQLite files there).
check_memory_index() {
    local body chunks=''
    body=$(curl --connect-timeout 3 --max-time 10 --fail --silent \
        "http://127.0.0.1:${BOAT_CHAT_PORT:-8765}/health" 2>/dev/null || true)
    if [ -n "$body" ]; then
        chunks=$(python3 -c '
import json, sys
try:
    print(int(json.load(sys.stdin)["readiness"]["layers"]["memory"]["chunks"]))
except (ValueError, TypeError, KeyError):
    pass
' <<<"$body" 2>/dev/null || true)
    fi
    if [ -z "$chunks" ]; then
        chunks=$(memory_index_helper status 2>/dev/null || true)
    fi
    case "$chunks" in
        '') printf 'WARN could not determine the Boat Chat memory index state (service not answering and the helper failed)\n' >&2; return 0 ;;
        0)
            printf 'FAIL Boat Chat memory index is empty (0 chunks), so Boat Chat reports "not ready".\n' >&2
            printf '     Fix: sudo vesselstackctl reindex\n' >&2
            return 1 ;;
        *[!0-9]*) printf 'WARN unexpected memory index state: %s\n' "$chunks" >&2; return 0 ;;
        *) printf 'OK   Boat Chat memory index: %s chunks\n' "$chunks" ;;
    esac
}

doctor_stack() {
    local failed=0 command free_kib
    printf 'VesselStack diagnostics\n\n'
    for command in docker curl tar sha256sum python3 systemctl; do
        if command -v "$command" >/dev/null 2>&1; then
            printf 'OK   command available: %s\n' "$command"
        else
            printf 'FAIL command missing: %s\n' "$command" >&2
            failed=1
        fi
    done
    if "${COMPOSE[@]}" config --quiet; then
        echo 'OK   Compose configuration is valid'
    else
        echo 'FAIL Compose configuration is invalid' >&2
        failed=1
    fi
    free_kib=$(df -Pk "$VESSELSTACK_DATA" | awk 'NR==2 {print $4}')
    if [ "${free_kib:-0}" -ge 1048576 ]; then
        printf 'OK   data filesystem free: %s MiB\n' "$((free_kib / 1024))"
    else
        echo 'FAIL data filesystem has less than 1 GiB free' >&2
        failed=1
    fi
    disk_usage_warning
    check_signalk_data_dir || failed=1
    check_memory_index || failed=1
    status_stack || failed=1
    if [ "$failed" -eq 0 ]; then
        echo 'RESULT healthy'
    else
        echo 'RESULT attention required' >&2
    fi
    return "$failed"
}

# Files outside the application and data trees that make a restore complete across
# versions: unit files, the control scripts and the update-key environment file.
extra_backup_paths() {
    local path
    for path in "$SYSTEMD_DIR"/vesselstack-* "$SBIN_DIR/vesselstackctl" \
        "$SBIN_DIR/vesselstack-firewall" "$SYSTEM_ROOT/etc/vesselstack/update.env"; do
        if [ -f "$path" ] && [ ! -L "$path" ]; then printf '%s\n' "$path"; fi
    done
}

# Nearest existing ancestor of a path (the destination may not exist yet).
existing_ancestor() {
    local path=$1
    while [ ! -e "$path" ] && [ "$path" != / ]; do path=$(dirname "$path"); done
    printf '%s' "$path"
}

check_backup_destination() {
    local destination=$1 allow_unmounted=$2 mount_dir ancestor
    case "$destination" in
        /media/*|/mnt/*)
            mount_dir=$(printf '%s' "$destination" | cut -d/ -f1-3)
            if ! mountpoint -q "$mount_dir"; then
                if [ "$allow_unmounted" -eq 1 ] || [ "${VESSELSTACK_BACKUP_ALLOW_UNMOUNTED:-false}" = true ]; then
                    echo "WARNING: $mount_dir is not a mounted filesystem; the backup will be written to the system disk" >&2
                else
                    echo "Refusing to back up: $mount_dir is not mounted, so the archive would silently land on the system disk (SD card). Mount the backup device or pass --allow-unmounted." >&2
                    return 1
                fi
            fi
            ;;
        *) ;;
    esac
    ancestor=$(existing_ancestor "$destination")
    if [ "$(stat -c %d "$ancestor")" = "$(stat -c %d "$VESSELSTACK_DATA")" ]; then
        echo "WARNING: the backup destination is on the same filesystem as the VesselStack data; it will not survive loss of that disk" >&2
    fi
}

backup_stack() {
    local allow_unmounted=0 destination=''
    while [ $# -gt 0 ]; do
        case "$1" in
            --allow-unmounted) allow_unmounted=1 ;;
            -*) echo "Unknown backup option: $1" >&2; exit 2 ;;
            *) [ -z "$destination" ] || { echo "backup takes at most one directory" >&2; exit 2; }
               destination=$1 ;;
        esac
        shift
    done
    destination=${destination:-${VESSELSTACK_BACKUP:-/var/backups/vesselstack}}
    local stamp archive manifest was_active=0
    local -a extras
    python3 - "$VESSELSTACK_ROOT" "$VESSELSTACK_DATA" "$destination" <<'PY'
import pathlib
import sys

root, data, backup = (pathlib.Path(value).resolve(strict=False) for value in sys.argv[1:])
if backup == pathlib.Path("/"):
    raise SystemExit("Backup destination must be a specific directory, not /")
if backup == root or root in backup.parents or backup == data or data in backup.parents:
    raise SystemExit("Backup destination must be outside the VesselStack application and data trees")
PY
    check_backup_destination "$destination" "$allow_unmounted"
    mapfile -t extras < <(extra_backup_paths)
    stamp=$(date -u +%Y%m%dT%H%M%SZ)
    archive="$destination/vesselstack-$stamp.tar.gz"
    manifest="$archive.sha256"
    install -d -m 0700 "$destination"
    if "${COMPOSE[@]}" ps --status running --quiet | grep -q .; then
        was_active=1
    fi
    cleanup_backup() {
        if [ "$was_active" -eq 1 ]; then start_stack; fi
    }
    trap cleanup_backup EXIT
    # The whole stack is stopped on purpose: InfluxDB (WAL/TSM), Home Assistant,
    # Grafana and Boat Chat all keep SQLite/WAL state in the data tree, and a
    # file-level copy of a running database is not crash-consistent.
    stop_stack
    tar --numeric-owner -czf "$archive" \
        --exclude="${VESSELSTACK_ROOT#/}/boat-chat/.venv" \
        --exclude="${VESSELSTACK_ROOT#/}/boat-chat/__pycache__" \
        --transform 's,^,vesselstack-backup/,' \
        "$VESSELSTACK_ROOT" "$VESSELSTACK_DATA" "${extras[@]}"
    sha256sum "$archive" > "$manifest"
    verify_backup "$archive" >/dev/null
    chmod 0600 "$archive" "$manifest"
    trap - EXIT
    cleanup_backup
    printf '%s\n' "$archive"
}

verify_backup() {
    local archive=$1 root_path data_path systemd_path sbin_path update_path entry invalid=0
    [ -f "$archive" ] || { echo "Backup not found: $archive" >&2; exit 1; }
    [ -f "$archive.sha256" ] || { echo "Checksum not found: $archive.sha256" >&2; exit 1; }
    (cd "$(dirname "$archive")" && sha256sum -c "$(basename "$archive").sha256")
    python3 - "$archive" "$VESSELSTACK_ROOT" "$VESSELSTACK_DATA" "$SYSTEMD_DIR" "$SBIN_DIR" \
        "$SYSTEM_ROOT/etc/vesselstack/update.env" <<'PY'
import pathlib
import sys
import tarfile

archive, root, data, systemd_dir, sbin_dir, update_env = sys.argv[1:]
prefix = pathlib.PurePosixPath("vesselstack-backup")
trees = [prefix / root.lstrip("/"), prefix / data.lstrip("/")]
systemd_base = prefix / systemd_dir.lstrip("/")
sbin_files = [prefix / sbin_dir.lstrip("/") / name for name in ("vesselstackctl", "vesselstack-firewall")]
update_file = prefix / update_env.lstrip("/")

def contained(path):
    if any(path == base or base in path.parents for base in trees):
        return True
    if path in sbin_files or path == update_file:
        return True
    return path.parent == systemd_base and path.name.startswith("vesselstack-")

with tarfile.open(archive, "r:gz") as bundle:
    for member in bundle.getmembers():
        path = pathlib.PurePosixPath(member.name)
        if path.is_absolute() or ".." in path.parts or not contained(path):
            raise SystemExit(f"Unsafe backup member: {member.name}")
        if member.isdev() or member.isfifo():
            raise SystemExit(f"Unsupported special file: {member.name}")
        if not member.issym() and member.mode & 0o7000:
            raise SystemExit(f"Refusing setuid/setgid/sticky member: {member.name}")
        if member.issym() or member.islnk():
            target = pathlib.PurePosixPath(member.linkname)
            if target.is_absolute():
                raise SystemExit(f"Unsafe absolute link: {member.name}")
            parts = []
            for part in (path.parent / target).parts:
                if part == "..":
                    if parts:
                        parts.pop()
                elif part != ".":
                    parts.append(part)
            if not contained(pathlib.PurePosixPath(*parts)):
                raise SystemExit(f"Unsafe link target: {member.name}")
PY
    root_path=${VESSELSTACK_ROOT#/}
    data_path=${VESSELSTACK_DATA#/}
    systemd_path=${SYSTEMD_DIR#/}
    sbin_path=${SBIN_DIR#/}
    update_path=${SYSTEM_ROOT#/}
    update_path=${update_path:+$update_path/}etc/vesselstack/update.env
    while IFS= read -r entry; do
        case "$entry" in
            "vesselstack-backup/$root_path"|"vesselstack-backup/$root_path/"*|\
            "vesselstack-backup/$data_path"|"vesselstack-backup/$data_path/"*|\
            "vesselstack-backup/$systemd_path/vesselstack-"*|\
            "vesselstack-backup/$sbin_path/vesselstackctl"|\
            "vesselstack-backup/$sbin_path/vesselstack-firewall"|\
            "vesselstack-backup/$update_path") ;;
            *) invalid=1 ;;
        esac
    done < <(tar -tzf "$archive")
    if [ "$invalid" -ne 0 ]; then
        echo "Backup contains paths outside this VesselStack installation" >&2
        exit 1
    fi
    echo "Backup verified (checksum, paths, links, file types, no setuid/setgid/sticky bits)"
}

# Swap a staged directory into place, keeping the old one as TARGET.pre-restore-STAMP.
swap_in() {
    local staged=$1 target=$2 stamp=$3
    if [ -e "$target" ] || [ -L "$target" ]; then
        mv -- "$target" "$target.pre-restore-$stamp" || return 1
    fi
    mv -- "$staged" "$target" || return 1
}

restore_stack() {
    local archive='' confirmation='' skip_installer=0 argument
    for argument in "$@"; do
        case "$argument" in
            --yes) confirmation=--yes ;;
            --skip-installer) skip_installer=1 ;;
            -*) echo "Unknown restore option: $argument" >&2; exit 2 ;;
            *) [ -z "$archive" ] || { echo "restore takes one archive" >&2; exit 2; }
               archive=$argument ;;
        esac
    done
    [ -n "$archive" ] || { usage; exit 2; }
    [ "$confirmation" = --yes ] || { echo "restore requires --yes" >&2; exit 2; }
    verify_backup "$archive"
    local root=$VESSELSTACK_ROOT data=$VESSELSTACK_DATA path
    for path in "$root" "$data"; do
        if mountpoint -q "$path" 2>/dev/null; then
            echo "Refusing to restore: $path is a mount point and cannot be swapped by rename. Restore manually (see README)." >&2
            exit 1
        fi
    done
    local stage_parent stamp stage need_kib free_kib
    stage_parent=$(dirname "$data")
    [ "$(stat -c %d "$stage_parent")" = "$(stat -c %d "$(dirname "$root")")" ] || {
        echo "Refusing to restore: application and data trees are on different filesystems from their parent directories" >&2
        exit 1
    }
    stamp=$(date -u +%Y%m%dT%H%M%SZ)
    # Staging holds a full second copy next to the live trees (same filesystem so the
    # swap is a rename); the old trees are then kept too, so check the space first.
    need_kib=$(python3 - "$archive" <<'PY'
import sys, tarfile
with tarfile.open(sys.argv[1], "r:gz") as bundle:
    print(sum(m.size for m in bundle.getmembers() if m.isreg()) // 1024 + 1)
PY
)
    free_kib=$(df -Pk "$stage_parent" | awk 'NR==2 {print $4}')
    if [ "${free_kib:-0}" -lt $((need_kib + need_kib / 10 + 102400)) ]; then
        echo "Not enough free space in $stage_parent to stage the restore: need about $((need_kib / 1024)) MiB plus margin, have $((free_kib / 1024)) MiB" >&2
        exit 1
    fi
    stage=$(mktemp -d "$stage_parent/.vesselstack-restore.XXXXXX")
    chmod 0700 "$stage"
    # Extract as root with recorded numeric owners (InfluxDB/Grafana/service user data must
    # keep their uid/gid); setuid/setgid/sticky members were already rejected above.
    if ! tar -xzf "$archive" -C "$stage" --numeric-owner --same-owner --preserve-permissions; then
        rm -rf -- "$stage"
        echo "Extraction failed; nothing was changed" >&2
        exit 1
    fi
    for path in "$root" "$data"; do
        [ -d "$stage/vesselstack-backup/${path#/}" ] || {
            rm -rf -- "$stage"
            echo "Backup does not contain $path; nothing was changed" >&2
            exit 1
        }
    done
    stop_stack
    if ! swap_in "$stage/vesselstack-backup/${data#/}" "$data" "$stamp"; then
        [ -e "$data" ] || { [ ! -e "$data.pre-restore-$stamp" ] || mv -- "$data.pre-restore-$stamp" "$data"; }
        echo "Restore failed while swapping the data tree; nothing else changed" >&2
        exit 1
    fi
    if ! swap_in "$stage/vesselstack-backup/${root#/}" "$root" "$stamp"; then
        # Put both trees back so root and data stay a matching pair.
        if [ ! -e "$root" ] && [ -e "$root.pre-restore-$stamp" ]; then
            mv -- "$root.pre-restore-$stamp" "$root" || true
        fi
        if [ -e "$data.pre-restore-$stamp" ]; then
            rm -rf -- "$data"
            mv -- "$data.pre-restore-$stamp" "$data" || true
        fi
        echo "Restore failed while swapping the application tree; previous trees put back" >&2
        exit 1
    fi
    # Restore unit files, control scripts and update.env via rename (the running
    # script keeps its old inode).
    local extra target
    while IFS= read -r extra; do
        target=/${extra#"$stage/vesselstack-backup/"}
        install -d -m 0755 "$(dirname "$target")"
        cp -p -- "$extra" "$target.restore-tmp"
        mv -f -- "$target.restore-tmp" "$target"
    done < <(find "$stage/vesselstack-backup" -type f \
        \( -path "$stage/vesselstack-backup/${SYSTEMD_DIR#/}/vesselstack-*" \
        -o -path "$stage/vesselstack-backup/${SBIN_DIR#/}/vesselstack*" \
        -o -path "$stage/vesselstack-backup/${SYSTEM_ROOT#/}/etc/vesselstack/update.env" \))
    rm -rf -- "$stage"
    systemctl daemon-reload
    if [ "$skip_installer" -eq 0 ] && [ -x "$root/installer/install.sh" ]; then
        # The backup excludes the Python virtualenv; the restored bundled installer
        # rebuilds it, re-renders units and starts the stack.
        "$root/installer/install.sh" --config "$root/config/vesselstack.env" --start
    else
        start_stack
        echo "NOTE: the Boat Chat virtualenv was not rebuilt. Run: sudo $root/installer/install.sh --config $root/config/vesselstack.env --start" >&2
    fi
    echo "Restore completed"
    echo "Previous trees kept as $root.pre-restore-$stamp and $data.pre-restore-$stamp."
    echo "Verify the system, then remove them to free disk space: sudo rm -rf -- '$root.pre-restore-$stamp' '$data.pre-restore-$stamp'"
}

update_stack() {
    local source='' offline=${VESSELSTACK_OFFLINE:-false} argument
    for argument in "$@"; do
        case "$argument" in
            --offline) offline=true ;;
            -*) usage >&2; exit 2 ;;
            *) [ -z "$source" ] || { usage >&2; exit 2; }; source=$argument ;;
        esac
    done
    [ -n "$source" ] || { usage >&2; exit 2; }
    case "$offline" in
        true|false) ;;
        *) echo "VESSELSTACK_OFFLINE must be true or false" >&2; exit 1 ;;
    esac
    local install_args=(--config "$ENV_FILE")
    [ "$offline" != true ] || install_args+=(--offline)
    [ -x "$source/install.sh" ] || { echo "Not a VesselStack release directory: $source" >&2; exit 1; }
    "$source/install.sh" "${install_args[@]}" --dry-run
    backup_stack "${VESSELSTACK_BACKUP:-/var/backups/vesselstack}"
    "$source/install.sh" "${install_args[@]}" --start
}

uninstall_stack() {
    local purge=0 confirmed=0 argument
    for argument in "$@"; do
        case "$argument" in
            --purge-data) purge=1 ;;
            --yes) confirmed=1 ;;
            *) echo "Unknown uninstall option: $argument" >&2; exit 2 ;;
        esac
    done
    if [ "$purge" -eq 1 ]; then
        [ "$confirmed" -eq 1 ] || { echo "--purge-data requires --yes" >&2; exit 2; }
        case "$VESSELSTACK_ROOT:$VESSELSTACK_DATA" in
            /opt/vesselstack:/opt/vesselstack-data) ;;
            *) echo "Refusing to purge non-default paths automatically" >&2; exit 1 ;;
        esac
    fi
    stop_stack
    systemctl disable vesselstack-chat.service || true
    systemctl disable --now vesselstack-chat-telegram.service || true
    systemctl disable --now vesselstack-telemetry-indexer.timer || true
    systemctl disable --now vesselstack-signalk.service || true
    systemctl disable --now vesselstack-socketcan.service || true
    systemctl disable --now vesselstack-control-panel.service || true
    if [ -x "$SBIN_DIR/vesselstack-firewall" ]; then
        "$SBIN_DIR/vesselstack-firewall" remove || true
    fi
    systemctl disable vesselstack-firewall.service || true
    rm -f -- "$SYSTEMD_DIR/vesselstack-chat.service" \
        "$SYSTEMD_DIR/vesselstack-chat-telegram.service" \
        "$SYSTEMD_DIR/vesselstack-telemetry-indexer.service" \
        "$SYSTEMD_DIR/vesselstack-telemetry-indexer.timer" \
        "$SYSTEMD_DIR/vesselstack-signalk.service" \
        "$SYSTEMD_DIR/vesselstack-socketcan.service" \
        "$SYSTEMD_DIR/vesselstack-control-panel.service" "$SBIN_DIR/vesselstackctl"
    rm -f -- "$SYSTEMD_DIR/vesselstack-firewall.service" "$SBIN_DIR/vesselstack-firewall"
    systemctl daemon-reload
    if [ "$purge" -eq 1 ]; then
        rm -rf -- /opt/vesselstack /opt/vesselstack-data
        echo "VesselStack services, configuration, and data removed"
    else
        echo "VesselStack services removed; data preserved at $VESSELSTACK_DATA"
    fi
}

[ $# -gt 0 ] || { usage; exit 2; }
command=$1
shift
case "$command" in
    help|-h|--help) usage; exit 0 ;;
esac
require_root
load_config
case "$command" in
    status) [ $# -eq 0 ] || { usage; exit 2; }; status_stack ;;
    doctor) [ $# -eq 0 ] || { usage; exit 2; }; doctor_stack ;;
    urls) [ $# -eq 0 ] || { usage; exit 2; }; show_urls ;;
    version) [ $# -eq 0 ] || { usage; exit 2; }; show_version ;;
    logs) [ $# -le 1 ] || { usage; exit 2; }; show_logs "${1:-all}" ;;
    reindex) [ $# -eq 0 ] || { usage; exit 2; }; memory_index_helper rebuild ;;
    start) [ $# -eq 0 ] || { usage; exit 2; }; start_stack ;;
    stop) [ $# -eq 0 ] || { usage; exit 2; }; stop_stack ;;
    restart) [ $# -eq 0 ] || { usage; exit 2; }; stop_stack; start_stack ;;
    backup) backup_stack "$@" ;;
    verify-backup) [ $# -eq 1 ] || { usage; exit 2; }; verify_backup "$1" ;;
    restore) [ $# -ge 2 ] || { usage; exit 2; }; restore_stack "$@" ;;
    update) [ $# -ge 1 ] || { usage; exit 2; }; update_stack "$@" ;;
    uninstall) uninstall_stack "$@" ;;
    *) echo "Unknown command: $command" >&2; usage; exit 2 ;;
esac
