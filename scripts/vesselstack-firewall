#!/bin/bash
# Restrict administrative ports on one explicitly untrusted interface.
#
# Usage: vesselstack-firewall [apply|remove|print]
#   apply   install the policy (root)
#   remove  remove the policy (root)
#   print   render the rules that apply would load, without root or changes
#
# Default policy: drop the administrative TCP ports (MQTT, InfluxDB, Prometheus,
# Grafana) arriving on the untrusted interface.
#
# Strict policy (VESSELSTACK_FIREWALL_STRICT=true): drop EVERYTHING arriving on the
# untrusted interface except replies to connections this host started, ICMP, DHCP
# client traffic and an explicit allow-list (VESSELSTACK_FIREWALL_ALLOW_TCP, default
# 22; VESSELSTACK_FIREWALL_ALLOW_UDP, default empty). This covers host-networked
# services (SignalK 3000, AIS) and Boat Chat 8765 through INPUT, and published
# container ports (Heimdall 80/443, Grafana, ...) through DOCKER-USER.
#
# Chain contents are replaced atomically with iptables-restore --noflush, so there
# is never a moment where an existing chain is empty. DOCKER-USER only exists once
# Docker has started: the host (INPUT) policy is applied first, then the script waits
# a bounded time for Docker's chain and creates it itself if Docker is still absent.
# Until Docker starts no container ports are published, so that gap exposes nothing.

set -euo pipefail

action=${1:-apply}
ENV_FILE=${VESSELSTACK_ENV:-/opt/vesselstack/config/vesselstack.env}
IPTABLES=${VESSELSTACK_IPTABLES:-/usr/sbin/iptables}
IP6TABLES=${VESSELSTACK_IP6TABLES:-/usr/sbin/ip6tables}
IPTABLES_RESTORE=${VESSELSTACK_IPTABLES_RESTORE:-/usr/sbin/iptables-restore}
IP6TABLES_RESTORE=${VESSELSTACK_IP6TABLES_RESTORE:-/usr/sbin/ip6tables-restore}
DOCKER_WAIT=${VESSELSTACK_FIREWALL_DOCKER_WAIT:-60}

case "$action" in
    apply|remove|print) ;;
    *) echo "Usage: vesselstack-firewall [apply|remove|print]" >&2; exit 2 ;;
esac

if [ -r "$ENV_FILE" ]; then
    # shellcheck disable=SC1090
    source "$ENV_FILE"
elif [ "$action" != print ]; then
    echo "Missing environment file: $ENV_FILE" >&2
    exit 1
fi
interface=${VESSELSTACK_UNTRUSTED_INTERFACE:-wlan0}
strict=${VESSELSTACK_FIREWALL_STRICT:-false}
allow_tcp=${VESSELSTACK_FIREWALL_ALLOW_TCP-22}
allow_udp=${VESSELSTACK_FIREWALL_ALLOW_UDP-}

if [ "$action" != print ]; then
    [ "$(id -u)" -eq 0 ] || { echo "Firewall changes require root" >&2; exit 1; }
fi
case "$interface" in
    ''|*[!A-Za-z0-9_.:-]*) echo "Invalid untrusted interface: $interface" >&2; exit 1 ;;
    *) ;;
esac
case "$strict" in
    true|false) ;;
    *) echo "VESSELSTACK_FIREWALL_STRICT must be true or false" >&2; exit 1 ;;
esac
valid_ports() {
    # Comma-separated ports or LOW:HIGH ranges, e.g. 22,5000:5100
    [[ -z $1 || $1 =~ ^[0-9]{1,5}(:[0-9]{1,5})?(,[0-9]{1,5}(:[0-9]{1,5})?)*$ ]]
}
valid_ports "$allow_tcp" || { echo "Invalid VESSELSTACK_FIREWALL_ALLOW_TCP: $allow_tcp" >&2; exit 1; }
valid_ports "$allow_udp" || { echo "Invalid VESSELSTACK_FIREWALL_ALLOW_UDP: $allow_udp" >&2; exit 1; }
for number in $(tr ':,' '  ' <<<"$allow_tcp $allow_udp"); do
    if [ "$number" -lt 1 ] || [ "$number" -gt 65535 ]; then
        echo "Firewall allow-list port out of range: $number" >&2
        exit 1
    fi
done

host_ports="${MQTT_PORT:-1883},${INFLUXDB_PORT:-8086},${PROMETHEUS_PORT:-9090},${GRAFANA_PORT:-43000}"

# Rules for one chain, in iptables-restore syntax (without the table header).
# $1 = input|docker, $2 = ip family (4|6)
chain_rules() {
    local kind=$1 family=$2 port
    if [ "$strict" != true ]; then
        if [ "$kind" = input ]; then
            echo "-A VESSELSTACK-INPUT -i $interface -p tcp -m multiport --dports $host_ports -j DROP"
        else
            echo "-A VESSELSTACK-DOCKER -i $interface -p tcp -m multiport --dports 1883,3000,8086,9090 -j DROP"
        fi
        return
    fi
    if [ "$kind" = input ]; then
        local chain=VESSELSTACK-INPUT
        echo "-A $chain -i $interface -m conntrack --ctstate ESTABLISHED,RELATED -j RETURN"
        if [ "$family" = 4 ]; then
            echo "-A $chain -i $interface -p icmp -j RETURN"
            echo "-A $chain -i $interface -p udp --dport 68 -j RETURN"
        else
            echo "-A $chain -i $interface -p ipv6-icmp -j RETURN"
            echo "-A $chain -i $interface -p udp --dport 546 -j RETURN"
        fi
        for port in ${allow_tcp//,/ }; do
            echo "-A $chain -i $interface -p tcp --dport $port -j RETURN"
        done
        for port in ${allow_udp//,/ }; do
            echo "-A $chain -i $interface -p udp --dport $port -j RETURN"
        done
        echo "-A $chain -i $interface -j DROP"
    else
        # Matches on the ORIGINAL (published, pre-DNAT) destination port.
        local chain=VESSELSTACK-DOCKER
        echo "-A $chain -i $interface -m conntrack --ctstate ESTABLISHED,RELATED -j RETURN"
        for port in ${allow_tcp//,/ }; do
            echo "-A $chain -i $interface -p tcp -m conntrack --ctorigdstport $port -j RETURN"
        done
        for port in ${allow_udp//,/ }; do
            echo "-A $chain -i $interface -p udp -m conntrack --ctorigdstport $port -j RETURN"
        done
        echo "-A $chain -i $interface -j DROP"
    fi
}

# Complete iptables-restore payload for one chain (replaced atomically).
chain_payload() {
    local kind=$1 family=$2 chain
    if [ "$kind" = input ]; then chain=VESSELSTACK-INPUT; else chain=VESSELSTACK-DOCKER; fi
    printf '*filter\n:%s - [0:0]\n-F %s\n' "$chain" "$chain"
    chain_rules "$kind" "$family"
    printf -- '-A %s -j RETURN\nCOMMIT\n' "$chain"
}

ensure_jump() {
    local command=$1 parent=$2 child=$3
    "$command" -C "$parent" -j "$child" 2>/dev/null || \
        "$command" -I "$parent" 1 -j "$child"
}

remove_chain() {
    local command=$1 parent=$2 child=$3
    while "$command" -C "$parent" -j "$child" 2>/dev/null; do
        "$command" -D "$parent" -j "$child"
    done
    "$command" -F "$child" 2>/dev/null || true
    "$command" -X "$child" 2>/dev/null || true
}

apply_input() {
    local command=$1 restore=$2 family=$3
    if [ ! -x "$command" ] || [ ! -x "$restore" ]; then
        if [ "$family" = 6 ]; then
            echo "WARNING: $command not available; IPv6 is NOT restricted" >&2
            return 0
        fi
        echo "Missing firewall command: $command" >&2
        return 1
    fi
    "$command" -N VESSELSTACK-INPUT 2>/dev/null || true
    chain_payload input "$family" | "$restore" --noflush
    ensure_jump "$command" INPUT VESSELSTACK-INPUT
}

wait_for_docker_user() {
    local waited=0
    until "$IPTABLES" -n -L DOCKER-USER >/dev/null 2>&1; do
        if [ "$waited" -ge "$DOCKER_WAIT" ]; then
            return 1
        fi
        sleep 2
        waited=$((waited + 2))
    done
}

apply_docker() {
    if ! wait_for_docker_user; then
        # Docker has not created its chain. Create it (Docker keeps an existing chain
        # and adds its own RETURN rule) so the policy is complete either way.
        echo "WARNING: DOCKER-USER not present after ${DOCKER_WAIT}s; creating it" >&2
        "$IPTABLES" -N DOCKER-USER 2>/dev/null || true
        "$IPTABLES" -C DOCKER-USER -j RETURN 2>/dev/null || "$IPTABLES" -A DOCKER-USER -j RETURN
    fi
    "$IPTABLES" -N VESSELSTACK-DOCKER 2>/dev/null || true
    chain_payload docker 4 | "$IPTABLES_RESTORE" --noflush
    ensure_jump "$IPTABLES" DOCKER-USER VESSELSTACK-DOCKER
}

case "$action" in
    print)
        printf '# interface=%s strict=%s allow_tcp=%s allow_udp=%s\n' \
            "$interface" "$strict" "$allow_tcp" "$allow_udp"
        printf '# iptables (IPv4) VESSELSTACK-INPUT, then jump INPUT -> VESSELSTACK-INPUT\n'
        chain_payload input 4
        printf '# ip6tables (IPv6) VESSELSTACK-INPUT, then jump INPUT -> VESSELSTACK-INPUT\n'
        chain_payload input 6
        printf '# iptables (IPv4) VESSELSTACK-DOCKER, then jump DOCKER-USER -> VESSELSTACK-DOCKER\n'
        chain_payload docker 4
        ;;
    apply)
        [ -e "/sys/class/net/$interface" ] || \
            echo "WARNING: untrusted interface $interface not present yet; rules are installed anyway and apply when it appears" >&2
        apply_input "$IPTABLES" "$IPTABLES_RESTORE" 4
        apply_input "$IP6TABLES" "$IP6TABLES_RESTORE" 6
        apply_docker
        ;;
    remove)
        remove_chain "$IPTABLES" INPUT VESSELSTACK-INPUT
        remove_chain "$IP6TABLES" INPUT VESSELSTACK-INPUT
        remove_chain "$IPTABLES" DOCKER-USER VESSELSTACK-DOCKER
        ;;
    *) ;;
esac
