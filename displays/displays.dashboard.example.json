{
  "schema": 1,
  "mqtt_host": "vesselstack.local",
  "heartbeat_s": 5,
  "night_schedule": {"start": "21:30", "end": "06:15"},
  "instruments": {
    "sog": {"path": "navigation.speedOverGround", "label": "SOG", "convert": "m/s->kn", "unit": "kn", "precision": 1, "stale_after_s": 10, "min_interval_ms": 500},
    "depth": {"path": "environment.depth.belowTransducer", "label": "Depth", "convert": "m->ft", "unit": "ft", "precision": 1, "stale_after_s": 10, "thresholds": {"alarm_below": 4, "warn_below": 8, "hysteresis": 0.5}},
    "house_v": {"path": "electrical.batteries.house.voltage", "label": "House", "convert": "none", "unit": "V", "precision": 2, "stale_after_s": 30, "thresholds": {"alarm_below": 11.8, "warn_below": 12.2, "warn_above": 14.8, "alarm_above": 15.2, "hysteresis": 0.1}, "min": 10, "max": 16},
    "start_v": {"path": "electrical.batteries.start.voltage", "label": "Start", "convert": "none", "unit": "V", "precision": 2, "stale_after_s": 30, "thresholds": {"alarm_below": 11.5, "warn_below": 12.0, "hysteresis": 0.1}},
    "fuel": {"path": "tanks.fuel.0.currentLevel", "label": "Fuel", "convert": "ratio->%", "unit": "%", "precision": 0, "stale_after_s": 60, "thresholds": {"alarm_below": 10, "warn_below": 25, "hysteresis": 2}, "min": 0, "max": 100},
    "water": {"path": "tanks.freshWater.0.currentLevel", "label": "Water", "convert": "ratio->%", "unit": "%", "precision": 0, "stale_after_s": 60, "thresholds": {"warn_below": 20, "hysteresis": 2}, "min": 0, "max": 100}
  },
  "notifications": {
    "anchor": {"path": "notifications.navigation.anchor", "label": "Anchor"},
    "low_battery": {"path": "notifications.electrical.batteries.house.voltage", "label": "Low battery", "absent": "ok"}
  },
  "displays": {
    "helm": {
      "name": "Helm",
      "board": "waveshare-esp32-s3-touch-lcd-2.8c",
      "ui": {"alarm_takeover": true, "alarm_page": 1, "swipe": true, "header": true, "night": "schedule", "day_brightness": 100, "night_brightness": 15, "dim_after_s": 120},
      "pages": [
        {"title": "Nav", "layout": "grid-2x2", "items": ["sog", "depth", "house_v", "start_v"]},
        {"title": "Status", "layout": "status-grid", "items": ["anchor", "low_battery", "depth", "house_v", "start_v", "fuel", "water"]},
        {"title": "Tanks", "layout": "grid-2x2", "items": ["fuel", "water"]}
      ]
    }
  }
}
