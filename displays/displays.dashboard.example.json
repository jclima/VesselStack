{
  "schema": 1,
  "mqtt_host": "vesselstack.local",
  "heartbeat_s": 5,
  "night_schedule": {"start": "21:30", "end": "06:15"},
  "instruments": {
    "sog": {"path": "navigation.speedOverGround", "label": "SOG", "convert": "m/s->kn", "unit": "kn", "precision": 1, "stale_after_s": 10, "min_interval_ms": 500},
    "depth": {"path": "environment.depth.belowTransducer", "label": "Depth", "convert": "m->ft", "unit": "ft", "precision": 1, "stale_after_s": 10, "thresholds": {"alarm_below": 4, "warn_below": 8, "hysteresis": 0.5}},
    "house_v": {"path": "electrical.batteries.house.voltage", "label": "House", "convert": "none", "unit": "V", "precision": 2, "stale_after_s": 30, "thresholds": {"alarm_below": 11.8, "warn_below": 12.2, "warn_above": 14.8, "alarm_above": 15.2, "hysteresis": 0.1}, "min": 10, "max": 16},
    "start_v": {"path": "electrical.batteries.start.voltage", "label": "Start", "convert": "none", "unit": "V", "precision": 2, "stale_after_s": 30, "thresholds": {"alarm_below": 11.5, "warn_below": 12.0, "hysteresis": 0.1}},
    "fuel": {"path": "tanks.fuel.0.currentLevel", "label": "Fuel", "convert": "ratio->%", "unit": "%", "precision": 0, "stale_after_s": 60, "thresholds": {"alarm_below": 10, "warn_below": 25, "hysteresis": 2}, "min": 0, "max": 100},
    "water": {"path": "tanks.freshWater.0.currentLevel", "label": "Water", "convert": "ratio->%", "unit": "%", "precision": 0, "stale_after_s": 60, "thresholds": {"warn_below": 20, "hysteresis": 2}, "min": 0, "max": 100},
    "waste": {"path": "tanks.blackWater.0.currentLevel", "label": "Waste", "convert": "ratio->%", "unit": "%", "precision": 0, "stale_after_s": 60, "thresholds": {"warn_above": 75, "alarm_above": 90, "hysteresis": 2}, "min": 0, "max": 100},
    "batt_soc": {"path": "electrical.batteries.house.capacity.stateOfCharge", "label": "SoC", "convert": "ratio->%", "unit": "%", "precision": 0, "stale_after_s": 60, "thresholds": {"alarm_below": 20, "warn_below": 30, "hysteresis": 2}, "min": 0, "max": 100},
    "batt_a": {"path": "electrical.batteries.house.current", "label": "Current", "convert": "none", "unit": "A", "precision": 1, "stale_after_s": 30},
    "solar_a": {"path": "electrical.solar.main.current", "label": "Solar", "convert": "none", "unit": "A", "precision": 1, "stale_after_s": 30}
  },
  "notifications": {
    "anchor": {"path": "notifications.navigation.anchor", "label": "Anchor"},
    "low_battery": {"path": "notifications.electrical.batteries.house.voltage", "label": "Low battery", "absent": "ok"}
  },
  "ha": {
    "bilge": {"entity_id": "binary_sensor.vesselstack_bilge_pump", "label": "Bilge", "kind": "binary", "states": [{"match": "on", "sev": "warn", "text": "RUNNING"}, {"match": "off", "sev": "ok", "text": "OFF"}]},
    "high_water": {"entity_id": "binary_sensor.vesselstack_high_water", "label": "High water", "kind": "binary", "states": [{"match": "on", "sev": "alarm", "text": "HIGH"}, {"match": "off", "sev": "ok", "text": "DRY"}]},
    "engine": {"entity_id": "sensor.engine_alarm_status", "label": "Engine", "kind": "state", "states": [{"match": "all clear", "sev": "ok", "text": "CLEAR"}, {"match": "normal", "sev": "ok", "text": "CLEAR"}], "default": {"sev": "alarm", "text": "ALARM"}},
    "shore": {"entity_id": "binary_sensor.vesselstack_shore_power", "label": "Shore", "kind": "binary", "alarm": false, "states": [{"match": "on", "sev": "ok", "text": "ON"}, {"match": "off", "sev": "ok", "text": "OFF"}]},
    "watch": {"entity_id": "sensor.boat_watch_summary", "label": "Watch", "kind": "state", "states": [{"match": "clear", "sev": "ok", "text": "CLEAR"}, {"prefix": "dock: clear", "sev": "ok", "text": "CLEAR"}, {"prefix": "anchor: clear", "sev": "ok", "text": "CLEAR"}, {"prefix": "away: clear", "sev": "ok", "text": "CLEAR"}], "default": {"sev": "warn", "text": "CHECK"}},
    "weather": {"entity_id": "sensor.weather_risk_level", "label": "Weather", "kind": "state", "states": [{"match": "normal", "sev": "ok", "text": "NORMAL"}, {"match": "low", "sev": "ok", "text": "LOW"}], "default": {"sev": "warn", "text": "RISK"}},
    "health": {"entity_id": "sensor.boat_health_summary", "label": "Health", "kind": "state", "states": [{"match": "ok", "sev": "ok", "text": "OK"}], "default": {"sev": "warn", "text": "CHECK"}}
  },
  "displays": {
    "helm": {
      "name": "Helm",
      "board": "waveshare-esp32-s3-touch-lcd-2.8c",
      "ui": {"alarm_takeover": true, "alarm_page": 1, "swipe": true, "header": true, "night": "schedule", "day_brightness": 100, "night_brightness": 15, "dim_after_s": 120},
      "pages": [
        {"title": "Nav", "layout": "grid-2x2", "items": ["sog", "depth", "house_v", "start_v"]},
        {"title": "Status", "layout": "status-grid", "items": ["anchor", "low_battery", "bilge", "high_water", "engine", "shore", "watch", "weather", "health"]},
        {"title": "Tanks", "layout": "tank-bars", "items": ["fuel", "water", "waste"]},
        {"title": "Fuel", "layout": "gauge-arc", "items": ["fuel"]},
        {"title": "Electrical", "layout": "electrical", "items": ["house_v", "batt_soc", "batt_a", "shore", "solar_a"]}
      ]
    }
  }
}
