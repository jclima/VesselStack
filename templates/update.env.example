# Private local update paths. Install as /etc/vesselstack/update.env, mode 600.
# The source checkout must be separate from the live application directory.
SOURCE_DIRECTORY="/opt/vesselstack-source"
TARGET_DIRECTORY="/opt/vesselstack"
CHAT_SERVICE="vesselstack-chat.service"
TELEGRAM_SERVICE="vesselstack-chat-telegram.service"
HEALTH_URL="http://127.0.0.1:8765/health"
# Pinned update remote. The checkout's "origin" must equal this exactly or the
# update refuses to fetch. Change only after reviewing why origin changed.
EXPECTED_REMOTE_URL="https://github.com/jclima/VesselStack.git"
# Source must have a valid signed commit or signed tag (verified by the checkout
# owner's GPG/SSH trust configuration). HOME-LAB ONLY: set to true to accept
# unsigned source. Never enable on a vessel that others can push code to.
ALLOW_UNSIGNED_SOURCE="false"
