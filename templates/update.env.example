# Private local update paths. Install as /etc/vesselstack/update.env, mode 600.
# The source checkout must be separate from the live application directory.
SOURCE_DIRECTORY="/opt/vesselstack-source"
TARGET_DIRECTORY="/opt/vesselstack"
CHAT_SERVICE="vesselstack-chat.service"
TELEGRAM_SERVICE="vesselstack-chat-telegram.service"
HEALTH_URL="http://127.0.0.1:8765/health"
# Pinned update remote. The checkout's "origin" must equal this exactly or the
# update refuses to fetch. Change only after reviewing why origin changed.
EXPECTED_REMOTE_URL="https://github.com/jclima/VesselStack.git"
# Source must have a valid signed commit or signed tag. Verification runs with a
# fixed git configuration (hooks off, no repository-local gpg/signer overrides)
# against a ROOT-CONTROLLED trust anchor, not the checkout owner's keyring:
#   - OpenPGP: a GNUPGHOME directory holding only the maintainer public key(s),
#     e.g.  sudo install -d -m 700 /etc/vesselstack/gnupg
#           sudo GNUPGHOME=/etc/vesselstack/gnupg gpg --import maintainer.asc
#   - or SSH signatures: an allowed-signers file (switches git to gpg.format=ssh).
# When running as root, the path and all its parents must be root-owned and not
# group/world-writable. If both are empty, the invoking user's default gpg home
# is used (root's ~/.gnupg under sudo).
VERIFY_GNUPGHOME=""
VERIFY_ALLOWED_SIGNERS=""
# Root-owned bare repository (mode 0700) holding fetched objects. Root verifies
# signatures and exports the release from here, never from the checkout (whose
# .git/config, attributes and hooks are controlled by the checkout owner).
UPDATE_MIRROR_DIR="/var/lib/vesselstack/update-mirror"
# HOME-LAB ONLY: set to true to accept
# unsigned source. Never enable on a vessel that others can push code to.
ALLOW_UNSIGNED_SOURCE="false"
