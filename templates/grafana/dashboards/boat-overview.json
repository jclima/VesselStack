          "query": "from(bucket: \"__VESSELSTACK_RAW_BUCKET__\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r.self == \"true\" and r._field == \"value\" and r._measurement =~ /^electrical\\.batteries\\..*\\.voltage$/)\n  |> aggregateWindow(every: v.windowPeriod, fn: last, createEmpty: false)",
