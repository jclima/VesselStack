 "instruments": {
  "batt_a": {
   "convert": "none",
   "icon": "electrical_services",
   "label": "Current",
   "path": "electrical.batteries.house.current",
   "precision": 1,
   "stale_after_s": 30,
   "unit": "A",
   "used_on": [
    "helm"
   ]
  },
  "batt_soc": {
   "convert": "ratio->%",
   "icon": "battery_charging_full",
   "label": "SoC",
   "max": 100,
   "min": 0,
   "path": "electrical.batteries.house.capacity.stateOfCharge",
   "precision": 0,
   "stale_after_s": 60,
   "thresholds": {
    "alarm_below": 20,
    "hysteresis": 2,
    "warn_below": 30
   },
   "unit": "%",
   "used_on": [
    "helm"
   ]
  },
  "depth": {
   "convert": "m->ft",
   "icon": "water",
   "label": "Depth",
   "path": "environment.depth.belowTransducer",
   "precision": 1,
   "stale_after_s": 10,
   "thresholds": {
    "alarm_below": 4,
    "hysteresis": 0.5,
    "warn_below": 8
   },
   "unit": "ft",
   "used_on": [
    "helm"
   ]
  },
  "fuel": {
   "convert": "ratio->%",
   "icon": "local_gas_station",
   "label": "Fuel",
   "max": 100,
   "min": 0,
   "path": "tanks.fuel.0.currentLevel",
   "precision": 0,
   "stale_after_s": 60,
   "thresholds": {
    "alarm_below": 10,
    "hysteresis": 2,
    "warn_below": 25
   },
   "unit": "%",
   "used_on": [
    "helm"
   ]
  },
  "house_v": {
   "convert": "none",
   "icon": "battery_full",
   "label": "House",
   "max": 16,
   "min": 10,
   "path": "electrical.batteries.house.voltage",
   "precision": 2,
   "stale_after_s": 30,
   "thresholds": {
    "alarm_above": 15.2,
    "alarm_below": 11.8,
    "hysteresis": 0.1,
    "warn_above": 14.8,
    "warn_below": 12.2
   },
   "unit": "V",
   "used_on": [
    "helm"
   ]
  },
  "sog": {
   "convert": "m/s->kn",
   "icon": "speed",
   "label": "SOG",
   "min_interval_ms": 500,
   "path": "navigation.speedOverGround",
   "precision": 1,
   "stale_after_s": 10,
   "unit": "kn",
   "used_on": [
    "helm"
   ]
  },
  "solar_a": {
   "convert": "none",
   "icon": "solar_power",
   "label": "Solar",
   "path": "electrical.solar.main.current",
   "precision": 1,
   "stale_after_s": 30,
   "unit": "A",
   "used_on": [
    "helm"
   ]
  },
  "start_v": {
   "convert": "none",
   "icon": "bolt",
   "label": "Start",
   "path": "electrical.batteries.start.voltage",
   "precision": 2,
   "stale_after_s": 30,
   "thresholds": {
    "alarm_below": 11.5,
    "hysteresis": 0.1,
    "warn_below": 12.0
   },
   "unit": "V",
   "used_on": [
    "helm"
   ]
  },
  "waste": {
   "convert": "ratio->%",
   "icon": "oil_barrel",
   "label": "Waste",
   "max": 100,
   "min": 0,
   "path": "tanks.blackWater.0.currentLevel",
   "precision": 0,
   "stale_after_s": 60,
   "thresholds": {
    "alarm_above": 90,
    "hysteresis": 2,
    "warn_above": 75
   },
   "unit": "%",
   "used_on": [
    "helm"
   ]
  },
  "water": {
   "convert": "ratio->%",
   "icon": "water_drop",
   "label": "Water",
   "max": 100,
   "min": 0,
   "path": "tanks.freshWater.0.currentLevel",
   "precision": 0,
   "stale_after_s": 60,
   "thresholds": {
    "hysteresis": 2,
    "warn_below": 20
   },
   "unit": "%",
   "used_on": [
    "helm"
   ]
  }
